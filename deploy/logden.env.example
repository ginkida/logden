# Скопировать в /etc/logden.env и заполнить.

# Общий токен(ы), которые клиенты шлют в Authorization: Bearer <...>
# openssl rand -hex 32 ; несколько через запятую — для ротации без даунтайма.
LOG_TOKEN=replace_with_long_random_shared_secret

# Слушать только loopback: TLS терминирует reverse-proxy (nginx/caddy) перед шлюзом.
LISTEN_ADDR=127.0.0.1:8080

# ClickHouse
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=writer
CLICKHOUSE_PASSWORD=CHANGE_ME_writer

# Поведение
LOG_LEVEL=info
BATCH_SIZE=500
BUFFER_SIZE=2000
FLUSH_INTERVAL=1s

# Спул для durability (StateDirectory из systemd-юнита)
SPOOL_DIR=/var/lib/logden
REPLAY_INTERVAL=30s

# Защита от абуза (0 = выключено)
RATE_LIMIT_RPS=0

# CIDR доверенных прокси для X-Forwarded-For (если за reverse-proxy — укажите его).
TRUSTED_PROXIES=127.0.0.1/32
