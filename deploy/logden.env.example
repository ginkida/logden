# Copy to /etc/logden.env and fill in.

# Shared token(s) clients send in Authorization: Bearer <...>
# openssl rand -hex 32 ; comma-separated for rotation without downtime.
LOG_TOKEN=replace_with_long_random_shared_secret

# Listen on loopback only: TLS is terminated by a reverse-proxy (nginx/caddy) in front of the gateway.
LISTEN_ADDR=127.0.0.1:8080

# ClickHouse
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=writer
CLICKHOUSE_PASSWORD=CHANGE_ME_writer

# Behavior
LOG_LEVEL=info
BATCH_SIZE=500
BUFFER_SIZE=2000
FLUSH_INTERVAL=1s

# Spool for durability (StateDirectory from the systemd unit)
SPOOL_DIR=/var/lib/logden
REPLAY_INTERVAL=30s

# Abuse protection (0 = disabled)
RATE_LIMIT_RPS=0

# Trusted proxy CIDRs for X-Forwarded-For (if behind a reverse-proxy — set it).
TRUSTED_PROXIES=127.0.0.1/32
