# Copy to /etc/logden.env and fill in:
#   install -m 600 -o root -g root deploy/logden.env.example /etc/logden.env
# It holds the shared token and the ClickHouse password; at a default umask the
# copy would otherwise land world-readable. systemd reads it as root (PID 1)
# before dropping to the DynamicUser, so 0600 costs nothing.
#
# Read by deploy/logden.service through EnvironmentFile=. Every variable the
# gateway understands is listed below with the default from `loadConfig` in
# gateway/main.go — that function, not this file, is the source of truth.
# systemd syntax: KEY=value, one per line, no shell expansion; quote a value
# that contains spaces. `systemctl restart logden` to apply.

# --- required ---

# Shared token(s) clients send in Authorization: Bearer <...>
# openssl rand -hex 32 ; comma-separated for rotation without downtime. Only
# commas and newlines split the list, so a token may contain spaces (quote it).
LOG_TOKEN=replace_with_long_random_shared_secret

# Password of the ClickHouse writer user. clickhouse/users.sql is a tracked
# template holding sha256_hash sentinels (__WRITER_HASH__/__READER_HASH__) that
# ClickHouse refuses outright — substitute them as that file's header describes,
# or keep an edited copy in clickhouse/users.local.sql (gitignored).
CLICKHOUSE_PASSWORD=replace_with_writer_password

# --- optional (with defaults) ---

# Listen on loopback only: TLS is terminated by a reverse-proxy (nginx/caddy) in
# front of the gateway. The gateway's own default is :8080 — every interface —
# so leave this line in place unless a host firewall closes the port.
LISTEN_ADDR=127.0.0.1:8080

# ClickHouse. The URL must be scheme://host[:port] and nothing else: the gateway
# concatenates "/?query=..." onto it, so a path, query, fragment or embedded
# credentials are refused at startup. DB/TABLE must name what
# clickhouse/schema.sql created (defaults: logs / logs).
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=writer
CLICKHOUSE_DB=logs
CLICKHOUSE_TABLE=logs

# Behavior. LOG_LEVEL is debug|info|warn|error (default info); raise it to
# warn/error to keep only problems — the gateway emits no debug records today,
# so debug equals info.
LOG_LEVEL=info

# Ingest batching. Bigger batches mean fewer ClickHouse inserts; a bigger buffer
# absorbs a longer burst before the gateway answers 503. BUFFER_SIZE drags two
# other settings with it, and neither follows automatically:
#   - memory: roughly BUFFER_SIZE x average row size, so raise MemoryHigh/
#     MemoryMax and GOMEMLIMIT in the unit alongside it;
#   - the shutdown budget: the drain flushes ceil(BUFFER_SIZE/BATCH_SIZE)
#     batches at 3s each, on top of 15s of HTTP shutdown and 15s for an insert
#     already in flight (~42s at these defaults). It must stay under
#     TimeoutStopSec (60 in deploy/logden.service), otherwise SIGKILL lands
#     mid-drain and the buffered events never reach the spool.
BATCH_SIZE=500
BUFFER_SIZE=2000
FLUSH_INTERVAL=1s

# Memory safety caps (bytes, 0 = disabled). When non-zero: BUFFER_MAX_BYTES must
# be >= 2x MAX_BODY_BYTES and MAX_INFLIGHT_BODY_BYTES >= MAX_BODY_BYTES.
# Sized for the unit defaults GOMEMLIMIT=80MiB / MemoryMax=128M — raise together.
BUFFER_MAX_BYTES=33554432
MAX_INFLIGHT_BODY_BYTES=16777216

# Per-request limits. A body over MAX_BODY_BYTES (the cap applies to the wire
# bytes and, separately, to the gunzipped stream) or a batch over
# MAX_BATCH_EVENTS is rejected whole with 413, so lowering either one without
# reconfiguring the senders turns a burst into lost events — the bundled clients
# cut their buffer on exactly these two numbers. An oversized message is
# truncated with a "…[truncated]" suffix (hence the >= 16 floor), an oversized
# context is discarded and replaced by {"_truncated":true,...}. MAX_BODY_BYTES is
# also the floor the two caps above are validated against, so raising it alone
# makes the gateway refuse to start.
MAX_BODY_BYTES=4194304
MAX_BATCH_EVENTS=1000
MAX_MESSAGE_BYTES=65536
MAX_CONTEXT_BYTES=65536

# Client timestamps older than this (or more than 5 minutes in the future) are
# rejected: the event is still stored, but under the gateway's ingest time, and
# logden_logs_restamped_total counts how often that happens. Keep it equal to the
# table TTL: change retention in clickhouse/migrations.sql and here in the same
# step (RUNBOOK.md), or the gateway keeps accepting rows ClickHouse deletes on
# the next merge.
RETENTION=720h

# GC ceiling. The unit sets GOMEMLIMIT=80MiB; uncomment to override (keep it
# below MemoryMax or the kernel OOM-kills the gateway before the GC reacts).
# GOMEMLIMIT=80MiB

# Spool for durability while ClickHouse is unavailable (SPOOL_DIR empty = spool
# off and failed batches are dropped; /var/lib/logden is the StateDirectory the
# unit creates). MAX_RETRIES insert retries follow the first attempt (backoff
# 200ms, doubling); after that the batch is written to disk and replayed every
# REPLAY_INTERVAL. The directory is capped twice, by batch count and by bytes
# (.bad quarantine files count too; 0 = unlimited) — over either cap a failed
# batch is dropped instead of filling the filesystem.
SPOOL_DIR=/var/lib/logden
MAX_RETRIES=3
REPLAY_INTERVAL=30s
SPOOL_MAX_FILES=1000
SPOOL_MAX_BYTES=268435456

# Abuse protection (0 = disabled). One global bucket for the whole gateway,
# applied after authentication: it caps total ingest, it does not isolate one
# noisy sender. RATE_BURST is the bucket ceiling; 0 means "same as
# RATE_LIMIT_RPS", and anything below 1 is raised to 1 (a request spends a whole
# token, so a smaller bucket would answer 429 to everything forever).
RATE_LIMIT_RPS=0
RATE_BURST=0

# Trusted proxy CIDRs for X-Forwarded-For (if behind a reverse-proxy — set it).
# List every hop: the chain is read right to left and stops at the first
# address that is not a trusted proxy. Empty = always use the real peer.
TRUSTED_PROXIES=127.0.0.1/32

# Token for /metrics (Authorization: Bearer). Empty = the endpoint is open and
# the gateway says so at startup; set it whenever /metrics is reachable from
# anywhere but loopback (SECURITY.md).
METRICS_TOKEN=

# Each secret also has a file form — the file wins over the plain variable and
# its contents are trimmed. With DynamicUser=yes the process UID changes between
# starts, so such a file must be readable by an unpredictable UID (or delivered
# with LoadCredential=); this file, which systemd reads as root, is the simpler
# place for a secret.
# LOG_TOKEN_FILE=/etc/logden/log_token
# CLICKHOUSE_PASSWORD_FILE=/etc/logden/ch_writer_password
# METRICS_TOKEN_FILE=/etc/logden/metrics_token
