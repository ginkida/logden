[Unit]
Description=logden ingest gateway
After=network.target clickhouse-server.service
Wants=clickhouse-server.service

[Service]
Type=simple
EnvironmentFile=/etc/logden.env
ExecStart=/usr/local/bin/logden
Restart=always
RestartSec=2
# Must cover the full drain: 15s HTTP shutdown + one insert that was already in
# flight when the drain began (15s, it keeps the pre-drain timeout) +
# ceil(BUFFER_SIZE/BATCH_SIZE) x 3s of flushing the remainder (to ClickHouse or the
# spool) = ~42s at the defaults. Set explicitly because a host with a low
# DefaultTimeoutStopSec would SIGKILL mid-drain and lose the buffered events.
# Keep in sync with stop_grace_period in docker-compose.yml.
TimeoutStopSec=60

# resources (don't compete with ClickHouse on a 1 GB box).
# GOMEMLIMIT must sit BELOW MemoryMax: it is a soft GC target, without it the
# Go runtime never sees the cgroup limit and the kernel OOM-kills the process.
# Values from EnvironmentFile override this default.
# MemoryMax matches the docker mem_limit (128M): GOMEMLIMIT 80MiB + up to 48MiB
# of byte-capped buffers (BUFFER_MAX_BYTES + MAX_INFLIGHT_BODY_BYTES) need real
# RSS headroom, so a large-body burst degrades to 503 instead of an OOM kill.
Environment=GOMEMLIMIT=80MiB
MemoryHigh=112M
MemoryMax=128M
CPUQuota=50%

# spool survives restarts: systemd creates the directory under the dynamic user
StateDirectory=logden

# isolation / sandbox
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
