[Unit]
Description=logden ingest gateway
After=network.target clickhouse-server.service
Wants=clickhouse-server.service

[Service]
Type=simple
EnvironmentFile=/etc/logden.env
ExecStart=/usr/local/bin/logden
Restart=always
RestartSec=2

# resources (don't compete with ClickHouse on a 1 GB box)
MemoryMax=64M
MemoryHigh=48M
CPUQuota=50%

# spool survives restarts: systemd creates the directory under the dynamic user
StateDirectory=logden

# isolation / sandbox
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
