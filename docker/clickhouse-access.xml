<?xml version="1.0"?>
<!--
  default needs access management so the init script can create writer/reader.
  We restrict default to loopback only: init and the healthcheck connect locally,
  while from the docker network (from the gateway) the writer/reader use their own
  credentials. This closes off access to the passwordless default from the network
  without touching init.
-->
<clickhouse>
    <users>
        <default>
            <access_management>1</access_management>
            <networks replace="replace">
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
        </default>
    </users>
</clickhouse>
