# Скопировать в .env и заполнить своими значениями.

# --- обязательное ---

# Общий токен(ы) для клиентов (Authorization: Bearer <...>).
# Сгенерировать: openssl rand -hex 32
# Можно несколько через запятую (для ротации без даунтайма).
LOG_TOKEN=change_me_shared_secret

# Пароли пользователей ClickHouse
CH_WRITER_PASSWORD=change_me_writer
CH_READER_PASSWORD=change_me_reader

# --- опциональное (со значениями по умолчанию) ---

# Порт, на котором шлюз доступен на хосте
GATEWAY_PORT=8080

# Интерфейс хоста для порта шлюза. По умолчанию 127.0.0.1 (только loopback) —
# наружу выставляйте через reverse-proxy с TLS (см. SECURITY.md).
# Прямой доступ извне без TLS (не рекомендуется): GATEWAY_BIND=0.0.0.0
GATEWAY_BIND=127.0.0.1

# Готовый образ шлюза из ghcr вместо локальной сборки (после релиза v*):
#   GATEWAY_IMAGE=ghcr.io/ginkida/logden:0.2.0
# затем: docker compose pull gateway && docker compose up -d
GATEWAY_IMAGE=

# Уровень логов шлюза: debug|info|warn|error
LOG_LEVEL=info

# Батчинг приёма. Память буфера ~ BUFFER_SIZE × средний размер строки;
# при росте BUFFER_SIZE поднимайте mem_limit/GOMEMLIMIT шлюза в compose.
BATCH_SIZE=500
BUFFER_SIZE=2000
FLUSH_INTERVAL=1s

# Дисковый спул (durability при недоступности ClickHouse): интервал реплея
REPLAY_INTERVAL=30s

# Лимит запросов в секунду (0 = выключено)
RATE_LIMIT_RPS=0

# CIDR доверенных прокси (для X-Forwarded-For). Пусто = всегда брать реальный peer.
TRUSTED_PROXIES=

# Токен для /metrics (Authorization: Bearer). Пусто = эндпоинт открыт.
METRICS_TOKEN=

# Метаданные сборки образа шлюза (подставляются в /version и метрику build_info)
VERSION=dev
COMMIT=none
BUILD_DATE=unknown
