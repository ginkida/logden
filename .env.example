# Copy to .env and fill in your own values:
#   cp .env.example .env && chmod 600 .env
# (the copy holds the shared token and both ClickHouse passwords).
#
# This is the full dictionary for the docker-compose path: the compose-only
# variables (GATEWAY_*, CH_*_PASSWORD, VERSION/COMMIT/BUILD_DATE) plus every
# gateway knob, each with the default from `loadConfig` in gateway/main.go —
# that function, not this file, is the source of truth. A gateway variable only
# has an effect if docker-compose.yml passes it into the container; the handful
# that compose pins itself are listed at the bottom, with what to edit instead.

# --- required ---

# Shared token(s) for clients (Authorization: Bearer <...>).
# Generate: openssl rand -hex 32
# Multiple allowed, comma-separated (for rotation without downtime). Only commas
# and newlines split the list, so a token may contain spaces.
LOG_TOKEN=change_me_shared_secret

# ClickHouse user passwords. CH_WRITER_PASSWORD is deliberately consumed twice by
# compose — it creates the writer user AND becomes the gateway's
# CLICKHOUSE_PASSWORD — so the two cannot drift. Both users are created only when
# the ch-data volume is first initialized: changing a password later needs an
# ALTER USER as well (SECURITY.md), editing this file alone just makes the
# gateway present a password ClickHouse no longer knows.
CH_WRITER_PASSWORD=change_me_writer
CH_READER_PASSWORD=change_me_reader

# --- optional (with defaults) ---

# Host port the gateway is exposed on
GATEWAY_PORT=8080

# Host interface for the gateway port. Defaults to 127.0.0.1 (loopback only) —
# expose it externally via a TLS reverse-proxy (see SECURITY.md).
# Direct external access without TLS (not recommended): GATEWAY_BIND=0.0.0.0
GATEWAY_BIND=127.0.0.1

# Prebuilt gateway image from ghcr instead of a local build (after a v* release):
#   GATEWAY_IMAGE=ghcr.io/ginkida/logden:0.4.0
# then: docker compose pull gateway && docker compose up -d
GATEWAY_IMAGE=

# Gateway log level: debug|info|warn|error. Raise it to warn/error to keep only
# problems; the gateway emits no debug records today, so debug equals info.
LOG_LEVEL=info

# Ingest batching. Bigger batches mean fewer ClickHouse inserts; a bigger buffer
# absorbs a longer burst before the gateway starts answering 503. Two things
# move with BUFFER_SIZE, and neither is automatic:
#   - memory: roughly BUFFER_SIZE x average row size, so raise the gateway
#     mem_limit/GOMEMLIMIT in docker-compose.yml alongside it;
#   - the shutdown budget: the drain flushes ceil(BUFFER_SIZE/BATCH_SIZE)
#     batches at 3s each, on top of 15s of HTTP shutdown and 15s for an insert
#     already in flight (~42s at these defaults). It must stay under
#     stop_grace_period (60s in docker-compose.yml), otherwise SIGKILL lands
#     mid-drain and the buffered events never reach the spool.
BATCH_SIZE=500
BUFFER_SIZE=2000
FLUSH_INTERVAL=1s

# Memory safety caps (bytes, 0 = disabled). Defaults are sized for
# GOMEMLIMIT=80MiB / mem_limit 128m — raise them together.
# BUFFER_MAX_BYTES: the buffer is bounded by bytes, not only by event count
# (large events would otherwise blow past the container limit).
# MAX_INFLIGHT_BODY_BYTES: total size of request bodies processed concurrently,
# charged as each body is actually read (so a stalled client holds almost
# nothing, and a small gzip request costs its real size, not the worst case);
# above the cap the gateway answers 503 (backpressure) instead of being OOM-killed.
# When non-zero: BUFFER_MAX_BYTES must be >= 2x MAX_BODY_BYTES (8388608 with the
# 4MiB default — a serialized row is larger than the raw body it came from) and
# MAX_INFLIGHT_BODY_BYTES must be >= MAX_BODY_BYTES. Smaller values are refused
# at startup.
BUFFER_MAX_BYTES=33554432
MAX_INFLIGHT_BODY_BYTES=16777216

# Per-request limits. A body over MAX_BODY_BYTES (the cap applies to the wire
# bytes and, separately, to the gunzipped stream) or a batch over
# MAX_BATCH_EVENTS is rejected whole with 413, so lowering either one
# without reconfiguring the senders turns a burst into lost events — the bundled
# clients cut their buffer on exactly these two numbers. An oversized message is
# truncated with a "…[truncated]" suffix (hence the >= 16 floor), an oversized
# context is discarded and replaced by {"_truncated":true,...}.
# MAX_BODY_BYTES is also the floor the two byte caps above are validated against,
# so raising it alone makes the gateway refuse to start, and MAX_BATCH_EVENTS
# must stay <= BUFFER_SIZE or a full-size batch can never be enqueued — not even
# on an idle gateway, which warns about exactly this at startup.
MAX_BODY_BYTES=4194304
MAX_BATCH_EVENTS=1000
MAX_MESSAGE_BYTES=65536
MAX_CONTEXT_BYTES=65536

# Client timestamps older than this (or more than 5 minutes in the future) are
# rejected: the event is still stored, but under the gateway's ingest time, and
# logden_logs_restamped_total counts how often that happens. Keep it equal to the
# table TTL: change retention in clickhouse/migrations.sql and here in the same
# step (RUNBOOK.md), or the gateway keeps accepting rows ClickHouse deletes on
# the next merge.
RETENTION=720h

# Disk spool — durability while ClickHouse is unavailable. MAX_RETRIES insert
# retries follow the first attempt (backoff 200ms, doubling); after that the
# batch is written to disk and replayed every REPLAY_INTERVAL. The spool is
# capped twice, by batch count and by bytes (.bad quarantine files count too;
# 0 = unlimited); over either cap a failed batch is dropped instead of filling
# the volume. SPOOL_DIR itself is pinned by compose to the gw-spool volume.
MAX_RETRIES=3
REPLAY_INTERVAL=30s
SPOOL_MAX_FILES=1000
SPOOL_MAX_BYTES=268435456

# Requests-per-second limit (0 = disabled). One global bucket for the whole
# gateway, applied after authentication: it caps total ingest, it does not
# isolate one noisy sender. RATE_BURST is the bucket ceiling; 0 means "same as
# RATE_LIMIT_RPS", and anything below 1 is raised to 1 (a request spends a whole
# token, so a smaller bucket would answer 429 to everything forever).
RATE_LIMIT_RPS=0
RATE_BURST=0

# Trusted proxy CIDRs (for X-Forwarded-For). Empty = always use the real peer.
# The chain is read right to left and stops at the first untrusted address, so
# list every hop in front of the gateway, not just the nearest one. In the Docker
# path the peer is the compose bridge, never the proxy's host address — use the
# network subnet:
#   docker network inspect logden_default -f '{{(index .IPAM.Config 0).Subnet}}'
# (172.16.0.0/12 covers the default bridge pools).
TRUSTED_PROXIES=

# Token for /metrics (Authorization: Bearer). Empty = the endpoint is open and
# the gateway says so at startup; set it whenever /metrics is reachable from
# anywhere but loopback (SECURITY.md).
METRICS_TOKEN=

# Database and table the gateway inserts into. They must name what
# clickhouse/schema.sql created when the ch-data volume was first initialized;
# renaming them here only makes every insert miss.
CLICKHOUSE_DB=logs
CLICKHOUSE_TABLE=logs

# Pinned by docker-compose.yml — setting these in .env does nothing; edit the
# gateway service instead:
#   LISTEN_ADDR=:8080                     the published port maps to container
#                                         :8080 (host side: GATEWAY_BIND/PORT)
#   CLICKHOUSE_URL=http://clickhouse:8123 the compose service address
#   CLICKHOUSE_USER=writer                the insert-only user
#   CLICKHOUSE_PASSWORD                   taken from CH_WRITER_PASSWORD above
#   SPOOL_DIR=/spool                      the gw-spool volume
#   GOMEMLIMIT=80MiB                      GC ceiling below mem_limit 128m
# Each secret also has a file form (LOG_TOKEN_FILE, CLICKHOUSE_PASSWORD_FILE,
# METRICS_TOKEN_FILE): the file wins over the plain variable and its contents are
# trimmed. Using one here means mounting the file into the container and adding
# the *_FILE variable to docker-compose.yml.

# Gateway image build metadata (surfaced in /version and the build_info metric)
VERSION=dev
COMMIT=none
BUILD_DATE=unknown
