<?xml version="1.0"?>
<!--
  Встроенный Prometheus-эндпоинт ClickHouse на порту 9363 (наружу НЕ публикуется).
  Даёт ProfileEvents_*, CurrentMetrics_*, ClickHouseAsyncMetrics_* без отдельного
  exporter'а (важно для 1 ГБ-бокса). Scrape изнутри docker-сети.
-->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <status_info>true</status_info>
    </prometheus>
</clickhouse>
