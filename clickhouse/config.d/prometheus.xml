<?xml version="1.0"?>
<!--
  ClickHouse built-in Prometheus endpoint on port 9363 (NOT published externally).
  Exposes ProfileEvents_*, CurrentMetrics_*, ClickHouseAsyncMetrics_* without a
  separate exporter (important on a 1 GB box). Scrape from within the docker network.
-->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <status_info>true</status_info>
    </prometheus>
</clickhouse>
