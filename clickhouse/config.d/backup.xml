<?xml version="1.0"?>
<!--
  Disk for native BACKUP/RESTORE (no external dependencies).
  The path lives inside the ch-data volume (writable). For real DR, copy the
  resulting backups to another host (see deploy/backup.sh).
-->
<clickhouse>
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/var/lib/clickhouse/backups/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
    </backups>
</clickhouse>
