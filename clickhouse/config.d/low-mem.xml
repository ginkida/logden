<?xml version="1.0"?>
<!--
  Tuning ClickHouse for a 1 GB box (leaving room for the gateway and the OS).
  Place in: /etc/clickhouse-server/config.d/low-mem.xml
-->
<clickhouse>
    <!-- Hard memory ceiling for the whole server: 768 MB -->
    <max_server_memory_usage>805306368</max_server_memory_usage>

    <!-- Mark cache: 128 MB instead of the default 5 GB. For a single narrow
         table even this is generous; the freed headroom lowers the chance of
         RSS overshooting the cgroup limit (RSS > max_server_memory_usage is
         the main OOM-kill vector on a small box). -->
    <mark_cache_size>134217728</mark_cache_size>

    <!-- Uncompressed block cache disabled -->
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <!-- Cap peak memory of background merges (safe, does not break startup) -->
    <merge_tree>
        <max_bytes_to_merge_at_max_space_in_pool>1073741824</max_bytes_to_merge_at_max_space_in_pool>
        <merge_max_block_size>2048</merge_max_block_size>
    </merge_tree>

    <!-- listen_host is left unset:
         - bare metal: ClickHouse listens on localhost only by default;
         - docker: the official image already listens on all interfaces, and the port is not published externally.
         background_pool_size is left untouched too: lowering it breaks startup
         (it requires background_pool_size * concurrency_ratio >= 20). -->
</clickhouse>
